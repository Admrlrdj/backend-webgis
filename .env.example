# NutriMap backend - konfigurasi lokal (salin ke .env)
PORT=5000
# dummy  = baca data/dummy/*.geojson, tanpa database
# postgis = pakai DATABASE_URL (jalankan npm run db:init lalu npm run db:import)
DATA_SOURCE=dummy
# DATABASE_URL=postgres://postgres:PASSWORD@localhost:5432/nutrimap

JWT_SECRET=ganti-dengan-nilai-sendiri
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173

# Akun uji lokal (dibuat otomatis di mode dummy, atau lewat npm run db:init)
ADMIN_EMAIL=admin@nutrimap.test
ADMIN_PASSWORD=ganti-dengan-nilai-sendiri
SUPERADMIN_EMAIL=superadmin@nutrimap.test
SUPERADMIN_PASSWORD=ganti-dengan-nilai-sendiri
